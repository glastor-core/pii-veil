{
  "name": "pii-veil-node",
  "version": "0.1.1",
  "description": "Ultrafast native Rust PII & Secret anonymizer and reversible vault for Node.js, Next.js, and MCP agents.",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT OR Apache-2.0",
  "napi": {
    "name": "pii-veil-node",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-gnu",
        "aarch64-apple-darwin"
      ]
    }
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.12"
  }
}
